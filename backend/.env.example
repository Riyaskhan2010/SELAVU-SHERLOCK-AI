# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev — no setup needed):
DATABASE_URL=sqlite:///./costlens.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Set ONE of the following three options:

# Option A: path to service account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option B: service account JSON as a single-line string (for cloud deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option C: GCP Application Default Credentials (Cloud Run / GCP only)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: groq | openai | anthropic | ollama | mock
LLM_PROVIDER=groq

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=allam-2-7b

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
